# Atlassian service account (Atlassian Administration -> Directory -> Service accounts).
# Username is its @serviceaccount.atlassian.com address; the token is generated by an org admin.
JIRA_EMAIL=jira-status-xxxxxxxxxx@serviceaccount.atlassian.com
# Token with read:jira-work, read:jira-user and write:jira-work scopes
JIRA_API_TOKEN=paste-service-account-api-token

# Postgres connection string from the Vercel Postgres / Neon integration.
# Vercel sets DATABASE_URL (Neon) or POSTGRES_URL automatically when you attach the store.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
