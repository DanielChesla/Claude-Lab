# Atlassian service account (Atlassian Administration -> Directory -> Service accounts).
# Username is its @serviceaccount.atlassian.com address; the token is generated by an org admin.
JIRA_EMAIL=jira-status-xxxxxxxxxx@serviceaccount.atlassian.com
# Token with read:jira-work, read:jira-user and write:jira-work scopes
JIRA_API_TOKEN=paste-service-account-api-token

# Optional: Microsoft Entra ID sign-in. Leave both unset to keep the typed-email gate.
# When both are set the email box disappears, users sign in with their work account, and every
# API call must carry a Microsoft ID token for this app. See README "Microsoft sign-in".
# ENTRA_TENANT_ID=0e1c4cb5-74f3-4ce0-b40e-801d3d150eb9
# ENTRA_CLIENT_ID=paste-application-client-id-from-the-app-registration
